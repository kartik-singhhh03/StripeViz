generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatar           String?
  emailVerified    Boolean           @default(false)
  oauthProvider    String?
  oauthProviderId  String?
  metricSnapshots  MetricSnapshot[]
  stripeConnection StripeConnection?
  subscription     Subscription?

  @@unique([oauthProvider, oauthProviderId])
  @@index([email])
  @@index([oauthProvider, oauthProviderId])
}

model StripeConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  stripeAccountId String    @unique
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeAccountId])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  stripeCustomerId   String    @unique
  plan               String    @default("free")
  status             String    @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

model Invoice {
  id                 String           @id @default(cuid())
  stripeConnectionId String
  stripeInvoiceId    String           @unique
  customerId         String
  amount             Int
  currency           String           @default("usd")
  status             String
  paidAt             DateTime?
  dueDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  stripeConnection   StripeConnection @relation(fields: [stripeConnectionId], references: [id], onDelete: Cascade)

  @@index([stripeConnectionId])
  @@index([stripeInvoiceId])
  @@index([customerId])
}

model MetricSnapshot {
  id                  String   @id @default(cuid())
  userId              String
  mrr                 Int      @default(0)
  arr                 Int      @default(0)
  activeSubscriptions Int      @default(0)
  failedPayments      Int      @default(0)
  totalRevenue        Int      @default(0)
  date                DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
