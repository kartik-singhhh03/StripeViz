# ============================================
# StripeViz Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================
# SECURITY: The server will FAIL TO START if required
# variables are missing or invalid. This is intentional!
# ============================================

# Node Environment
NODE_ENV=development

# Database (PostgreSQL - Neon recommended)
# REQUIRED - Server will not start without this
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============================================
# SECURITY SECRETS (REQUIRED)
# ============================================
# Generate secure secrets with: openssl rand -base64 64
# MUST be at least 32 characters - NO PLACEHOLDER VALUES!

JWT_SECRET=GENERATE_A_SECURE_64_CHARACTER_RANDOM_STRING_HERE
SESSION_SECRET=GENERATE_ANOTHER_SECURE_64_CHARACTER_STRING_HERE

# ============================================
# PADDLE CONFIGURATION (Primary Payment - REQUIRED)
# ============================================
# Get credentials from: https://vendors.paddle.com/authentication
# Paddle is a Merchant of Record - handles tax, VAT, compliance

# Server-side API Key (keep secret!)
PADDLE_API_KEY=your_paddle_api_key

# Webhook Secret for signature verification
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# Environment: 'sandbox' for testing, 'production' for live
PADDLE_ENVIRONMENT=sandbox

# Client-side Token (safe to expose to frontend)
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token

# Price IDs for subscription products (create in Paddle Dashboard)
PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx
PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx
PADDLE_ENTERPRISE_MONTHLY_PRICE_ID=pri_xxx
PADDLE_ENTERPRISE_YEARLY_PRICE_ID=pri_xxx

# Frontend price ID env vars (for Vite)
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx
VITE_PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx
VITE_PADDLE_ENTERPRISE_MONTHLY_PRICE_ID=pri_xxx
VITE_PADDLE_ENTERPRISE_YEARLY_PRICE_ID=pri_xxx
VITE_PADDLE_ENVIRONMENT=sandbox

# ============================================
# OAuth - Google (OPTIONAL)
# ============================================
# Create at: https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google OAuth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ============================================
# OAuth - GitHub (OPTIONAL)
# ============================================
# Create at: https://github.com/settings/developers
# Leave blank to disable GitHub OAuth

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# ============================================
# EMAIL - Resend (OPTIONAL)
# ============================================
# Get API key from: https://resend.com
# Required for: password reset, notifications, alerts
# Leave blank to disable email features

RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# Stripe API Keys (OPTIONAL - Legacy)
# ============================================
# Paddle is the primary payment provider
# Stripe is optional for legacy users

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Subscription Price IDs (optional)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_LIFETIME=

# ============================================
# Application URLs
# ============================================
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# ===========================================
# VERCEL DEPLOYMENT (Frontend only)
# ===========================================
# If deploying frontend on Vercel and backend elsewhere,
# set this in Vercel's environment variables:
# VITE_API_URL=https://your-backend-domain.com

# Optional: Debug message
PING_MESSAGE=pong
